<Window x:Class="AEP_ProjectHub.Views.PackageReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Package Review"
        Height="700"
        Width="1100"
		Icon="/Images/Designer.ico"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->

		<StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

			<TextBlock Text="Package Review"
                       FontSize="28"
                       FontWeight="Bold"/>

			<TextBlock Text="Assign documents to packets and organize packet order."
                       Foreground="Gray"/>

		</StackPanel>

		<!-- Package Information -->

		<Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,15"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8">

			<UniformGrid Columns="3">

				<StackPanel Margin="10">
					<TextBlock Text="WR Number"
                               FontWeight="Bold"/>
					<TextBlock x:Name="lblWR"/>
				</StackPanel>

				<StackPanel Margin="10">
					<TextBlock Text="Job Number"
                               FontWeight="Bold"/>
					<TextBlock x:Name="lblJob"/>
				</StackPanel>

				<StackPanel Margin="10">
					<TextBlock Text="DCP Number"
                               FontWeight="Bold"/>
					<TextBlock x:Name="lblDcp"/>
				</StackPanel>

				<StackPanel Margin="10,10,158,10">
					<TextBlock Text="District Number"
								FontWeight="Bold" Width="114"
							   HorizontalAlignment="Left"/>
					<TextBox x:Name="txtDistrict"
								Width="120"
							 HorizontalAlignment="Left"
							 MaxLength="3"/>
				</StackPanel>
				<CheckBox x:Name="chkPushToStorms"
							  Content="Push to Storms"
							  Margin="-158,10,354,0"/>


			</UniformGrid>

		</Border>

		<!-- Documents -->

		<GroupBox Grid.Row="2"
                  Header="Packet Document Assignment">

			<DataGrid x:Name="lstDocuments"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      Margin="5">

				<DataGrid.Columns>

					<DataGridTextColumn Header="File Name"
                                        Binding="{Binding FileName}"
                                        Width="*" />

					<DataGridCheckBoxColumn Header="Construction"
                                            Binding="{Binding IncludeInConstruction}"
                                            Width="120" />

					<DataGridCheckBoxColumn Header="Clearing"
                                            Binding="{Binding IncludeInClearing}"
                                            Width="120" />

					<DataGridCheckBoxColumn Header="Stores"
                                            Binding="{Binding IncludeInStores}"
                                            Width="120" />

					<!-- Move Up -->

					<DataGridTemplateColumn Header="▲"
                                            Width="55">

						<DataGridTemplateColumn.CellTemplate>

							<DataTemplate>

								<Button Content="▲"
                                        Tag="{Binding}"
                                        Click="MoveUp_Click"/>

							</DataTemplate>

						</DataGridTemplateColumn.CellTemplate>

					</DataGridTemplateColumn>

					<!-- Move Down -->

					<DataGridTemplateColumn Header="▼"
                                            Width="55">

						<DataGridTemplateColumn.CellTemplate>

							<DataTemplate>

								<Button Content="▼"
                                        Tag="{Binding}"
                                        Click="MoveDown_Click"/>

							</DataTemplate>

						</DataGridTemplateColumn.CellTemplate>

					</DataGridTemplateColumn>

					<!-- Delete -->

					<DataGridTemplateColumn Header="Remove"
                                            Width="80">

						<DataGridTemplateColumn.CellTemplate>

							<DataTemplate>

								<Button Content="🗑"
                                        Width="35"
                                        Height="35"
                                        Tag="{Binding}"
                                        Click="DeleteDocument_Click"/>

							</DataTemplate>

						</DataGridTemplateColumn.CellTemplate>

					</DataGridTemplateColumn>

				</DataGrid.Columns>

			</DataGrid>

		</GroupBox>

		<!-- Footer -->

		<DockPanel Grid.Row="3"
                   Margin="0,20,0,0">

			<TextBlock Text="Use ▲ and ▼ to control PDF page order."
                       VerticalAlignment="Center"
                       Foreground="Gray"/>

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

				<Button Content="Cancel"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

				<Button Content="Build Packets"
                        Width="180"
                        Height="40"
                        Click="BuildAll_Click"/>

			</StackPanel>

		</DockPanel>

	</Grid>

</Window>