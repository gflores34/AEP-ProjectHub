<Page x:Class="AEP_ProjectHub.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  Title="AEP ProjectHub-Dashboard">

	<ScrollViewer>

		<StackPanel Margin="20">

			<Grid Margin="0,0,0,20">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">

					<TextBlock Text="ProjectHub"
                               FontSize="32"
                               FontWeight="Bold" />


				</StackPanel>

				<Image Grid.Column="1"
                       Source="/Images/Texas_Tag_RGB_RB.png"
                       Height="120"
                       Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       Stretch="Uniform" />

			</Grid>

			<WrapPanel>

				<Button x:Name="btnPackageManager"
                        Width="250"
                        Height="120"
                        Margin="10"
                        Click="btnPackageManager_Click">

					<StackPanel>

						<TextBlock Text="Package Manager"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />

						<TextBlock Text="Build job packets"
                                   HorizontalAlignment="Center" />

					</StackPanel>

				</Button>

				<Button x:Name="buttonTODO"
                        Width="250"
                        Height="120"
                        Margin="10">

					<StackPanel>

						<TextBlock Text="WORK IN PROGRESS"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />

						<TextBlock Text="COMING SOON"
                                   HorizontalAlignment="Center" />

					</StackPanel>

				</Button>

			</WrapPanel>

		</StackPanel>

	</ScrollViewer>

</Page>