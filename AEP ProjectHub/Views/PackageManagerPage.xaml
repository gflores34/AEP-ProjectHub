<Page x:Class="AEP_ProjectHub.Views.PackageManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Package Manager">

	<Grid Background="#F5F7FA">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->

		<Grid Grid.Row="0"
			  Margin="20,20,20,10">

			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- Left Side -->

			<StackPanel Grid.Column="0">

				<TextBlock Text="Package Manager"
						   FontSize="30"
						   FontWeight="SemiBold"/>

				<TextBlock Text="Build and organize construction package documents"
						   Foreground="Gray"
						   Margin="0,5,0,0"/>

			</StackPanel>

			<!-- Right Side -->

			<Image
				   Source="/Images/Texas_Tag_RGB_RB.png"
				   Height="120"
				   
				   VerticalAlignment="Center"
				   HorizontalAlignment="Right"
				   Grid.ColumnSpan="2" 
				   Margin="500,0,0,0"/>

		</Grid>

		<!-- Metadata -->

		<Grid Grid.Row="1"
              Margin="20,0,20,10">

			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
                    Margin="5"
                    Background="White"
                    CornerRadius="10"
                    Padding="15">

				<StackPanel>
					<TextBlock Text="WR NUMBER"
                               FontWeight="Bold"
                               Foreground="Gray"/>

					<TextBox x:Name="txtWrNumber"
                             FontSize="20"
                             BorderThickness="0"
                             Margin="0,10,0,0"/>
				</StackPanel>

			</Border>

			<Border Grid.Column="1"
                    Margin="5"
                    Background="White"
                    CornerRadius="10"
                    Padding="15">

				<StackPanel>
					<TextBlock Text="JOB NUMBER"
                               FontWeight="Bold"
                               Foreground="Gray"/>

					<TextBox x:Name="txtJobNumber"
                             FontSize="20"
                             BorderThickness="0"
                             Margin="0,10,0,0"/>
				</StackPanel>

			</Border>

			<Border Grid.Column="2"
                    Margin="5"
                    Background="White"
                    CornerRadius="10"
                    Padding="15">

				<StackPanel>
					<TextBlock Text="DCP NUMBER"
                               FontWeight="Bold"
                               Foreground="Gray"/>

					<TextBox x:Name="txtDcpNumber"
                             FontSize="20"
                             BorderThickness="0"
                             Margin="0,10,0,0"/>
				</StackPanel>

			</Border>

		</Grid>

		<!-- File Area -->

		<Border Grid.Row="2"
                Margin="20,0,20,10"
                Background="White"
                CornerRadius="10"
                BorderBrush="#D8DDE6"
                BorderThickness="1"
                AllowDrop="True"
                Drop="DropArea_Drop"
                DragEnter="DropArea_DragEnter">

			<Grid>

				<StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

					<TextBlock Text="📄"
                               FontSize="70"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Drop PDF Files Here"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

					<TextBlock Text="Drag files or click Add Files below"
                               Foreground="Gray"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

				</StackPanel>

				<ListBox x:Name="lstFiles"
                         Margin="15"
                         Background="Transparent"
                         BorderThickness="0"/>

			</Grid>

		</Border>

		<!-- Footer -->

		<Grid Grid.Row="3"
              Margin="20,0,20,20">

			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock VerticalAlignment="Center"
                       Foreground="Gray"
                       FontSize="14"
                       Text="Drop a Job Card to auto-populate package information." />

			<Button Grid.Column="1"
                    Width="140"
                    Height="44"
                    Margin="0,0,10,0"
                    Content="Add Files"
                    Click="btnAddFiles_Click"/>

			<Button Grid.Column="2"
                    Width="160"
                    Height="44"
                    Content="Review Package"
                    Click="btnBuildPackage_Click"/>

		</Grid>

	</Grid>

</Page>